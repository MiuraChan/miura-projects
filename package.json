{
  "name": "grayfox-video-studio",
  "version": "0.2.2",
  "description": "Local-first AI video editing and Story Clips desktop prototype",
  "main": "electron/main.cjs",
  "author": "Grayfox",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview-server.cjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:electron": "node scripts/electron-smoke.cjs",
    "test:all": "npm run test && npm run test:electron && npm run test:ffmpeg && npm run test:edit && npm run test:edit-resilience && npm run test:ai",
    "dist": "npm run test:all && electron-builder --win portable",
    "test:ffmpeg": "electron scripts/ffmpeg-integration.cjs",
    "test:ai": "electron scripts/local-ai-integration.cjs",
    "test:edit": "electron scripts/edit-integration.cjs",
    "test:edit-resilience": "electron scripts/edit-resilience-integration.cjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.grayfox.videostudio",
    "productName": "Grayfox",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "Grayfox-${version}-Windows.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
