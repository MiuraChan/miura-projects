{
  "hosting": {
    "headers": [
      {
        "source": "/meiling/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/grayfox/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/Francesco-Saccullo_CV.pdf",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Francesco-Saccullo_CV.pdf\""
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/Francesco-Saccullo_CV_IT.pdf",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Francesco-Saccullo_CV_IT.pdf\""
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/greyfox",
        "statusCode": 301,
        "location": "/grayfox/"
      },
      {
        "source": "/greyfox/**",
        "statusCode": 301,
        "location": "/grayfox/"
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "path": "/index.html"
      }
    ],
    "site": "francesco-saccullo-mediakit",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
