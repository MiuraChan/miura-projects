{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/meiling/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/Francesco-Saccullo_CV.pdf",
        "headers": [
          {
            "value": "attachment; filename=\"Francesco-Saccullo_CV.pdf\"",
            "key": "Content-Disposition"
          },
          {
            "value": "public,max-age=3600",
            "key": "Cache-Control"
          }
        ]
      }
    ],
    "site": "francesco-saccullo-mediakit"
  }
}
